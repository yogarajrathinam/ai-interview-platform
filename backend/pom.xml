<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.aiinterview</groupId>
  <artifactId>interview-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>AI Interview Platform</name>
  <description>Phase 0 — modular monolith foundation and database baseline</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.3.0</archunit.version>
    <uuid-generator.version>5.1.0</uuid-generator.version>
    <anthropic-sdk.version>2.34.0</anthropic-sdk.version>
    <wiremock.version>3.9.2</wiremock.version>
    <!-- Empty by default so surefire runs every non-excluded group. -->
    <surefire.groups></surefire.groups>
  </properties>

  <dependencies>
    <!-- Web / validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence. Hibernate NEVER owns the schema: ddl-auto=validate. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Security foundation only: no authentication flow in M0/M1. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- UUIDv7 (time-ordered) generation at the application layer. -->
    <dependency>
      <groupId>com.fasterxml.uuid</groupId>
      <artifactId>java-uuid-generator</artifactId>
      <version>${uuid-generator.version}</version>
    </dependency>

    <!--
      Anthropic SDK. Reachable ONLY from evaluation.infrastructure.anthropic —
      an ArchUnit rule fails the build if a vendor type escapes an
      infrastructure package, which is what keeps the provider replaceable.
    -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic-sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ==== test ==== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      Serves canned HTTP responses so the real adapter is exercised over real
      HTTP without a live API. CI must never depend on a paid provider.
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Database-backed tests are tagged and excluded when no
               container runtime is available: -DexcludedGroups=database.
               live-ai is excluded by every profile except -Plive-ai. -->
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          <groups>${surefire.groups}</groups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Default: run everything, including Testcontainers. -->
      <id>all-tests</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties><surefire.excludedGroups>live-ai</surefire.excludedGroups></properties>
    </profile>
    <profile>
      <!-- mvn test -Pno-docker  — architecture and unit tests only. -->
      <id>no-docker</id>
      <properties><surefire.excludedGroups>database,live-ai</surefire.excludedGroups></properties>
    </profile>
    <profile>
      <!--
        mvn test -Plive-ai -Dtest=GoldenSetLiveEvaluationTest

        Runs the golden set against the REAL provider. Opt-in only: it spends
        money and needs ANTHROPIC_API_KEY, so it is excluded from every other
        profile including the default. Nothing here runs during `mvn verify`.
      -->
      <id>live-ai</id>
      <properties>
        <surefire.excludedGroups></surefire.excludedGroups>
        <surefire.groups>live-ai</surefire.groups>
      </properties>
    </profile>
  </profiles>
</project>
