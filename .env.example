# Copy to .env and fill in locally. .env is git-ignored — never commit real values.
# These are PLACEHOLDERS. Do not paste production credentials into this file.

# ---------------------------------------------------------------- database
# The application user needs DML on the `app` schema and nothing more.
# Migrations run as a separate user holding DDL rights.
DATABASE_URL=jdbc:postgresql://localhost:5432/interview_platform
DATABASE_USERNAME=interview
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10

# ------------------------------------------------------------- application
APP_ENVIRONMENT=local
SERVER_PORT=8080

# ------------------------------------------------------------------- tests
# Optional. Points the database test suite at an existing PostgreSQL instead
# of Testcontainers. Use a DISPOSABLE database: the suite writes freely.
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5433/interview_platform_test
# TEST_DATABASE_USERNAME=postgres
# TEST_DATABASE_PASSWORD=change-me

# ------------------------------------------------------- later milestones
# Not used yet. Listed so the shape is known; values arrive with M6 and M2.
# SUPABASE_PROJECT_URL=
# SUPABASE_JWKS_URL=
# APP_BOOTSTRAP_ADMIN_EMAILS=
# AI_PROVIDER_API_KEY=
